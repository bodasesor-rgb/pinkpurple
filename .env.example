SITE_BASE=https://pinkpurple.seo

# Candado del prototipo (toda la web). Vacío o ENABLED=false = sin candado.
VITE_SITE_GATE_ENABLED=true
VITE_SITE_GATE_PASSWORD=PinkPurple2026!

# ── API de Nexus (motor PinkPurple en Hostinger) ──────────────────────
# SOLO servidor: la lee la Netlify Function `nexus-proxy`. Sin prefijo VITE_.
# Origen del sitio Hostinger (sin /api al final):
NEXUS_API_URL=https://white-ferret-567834.hostingersite.com

# ── Panel (navegador) ─────────────────────────────────────────────────
# Base de las llamadas del panel. Por defecto /api → Netlify Function.
# VITE_API_BASE=/api

# Arranca el panel con datos MOCK, sin Nexus (solo desarrollo):
#   VITE_USE_MOCKS=true npm run dev
# VITE_USE_MOCKS=false
